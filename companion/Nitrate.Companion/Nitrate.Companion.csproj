<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>Nitrate.Companion</RootNamespace>
    <AssemblyVersion>0.1.0.0</AssemblyVersion>
    <FileVersion>0.1.0.0</FileVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
  </PropertyGroup>

  <ItemGroup>
    <!-- Provided by the server at run time: compile against them, never ship them. -->
    <PackageReference Include="Jellyfin.Controller" Version="12.4.0" ExcludeAssets="runtime" />
    <PackageReference Include="Jellyfin.Model" Version="12.4.0" ExcludeAssets="runtime" />
    <!-- The server ships SQLite (with full-text search) for its own database: use its copy. -->
    <PackageReference Include="Microsoft.Data.Sqlite.Core" Version="10.0.0" ExcludeAssets="runtime" />
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
    <!-- Reads CBR, CB7 and CBT comics (MIT); shipped beside the plugin. -->
    <PackageReference Include="SharpCompress" Version="0.50.10" />
  </ItemGroup>

  <ItemGroup>
    <None Remove="Configuration/configPage.html" />
    <EmbeddedResource Include="Configuration/configPage.html" />
    <!-- The TV and receiver check clips (tools/generate-badge-clips.sh), served at /Nitrate/TestClips. -->
    <EmbeddedResource Include="TestClips/*" LogicalName="Nitrate.Companion.TestClips.%(Filename)%(Extension)" />
  </ItemGroup>

</Project>
