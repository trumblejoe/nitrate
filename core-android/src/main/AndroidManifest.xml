<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Installing updates downloaded from the project's releases (Android asks the user each time). -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />
    <!-- Noticing a network change (leaving home Wi-Fi) to move between the server's addresses. -->
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- Lets Android 12+ apply an update without asking again once Nitrate installed the version being replaced. -->
    <uses-permission android:name="android.permission.UPDATE_PACKAGES_WITHOUT_USER_ACTION" />

    <application>
        <!-- EPUB books (Readium), opened from either app's book pages. -->
        <activity
            android:name="dev.nitrate.android.books.EpubReaderActivity"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden"
            android:exported="false"
            android:theme="@style/Theme.AppCompat.NoActionBar" />
        <receiver
            android:name="dev.nitrate.android.update.InstallResultReceiver"
            android:exported="false" />
        <!-- A watch party notification's buttons (+15 min, Not tonight, Yes/No), answered without opening the app. -->
        <receiver
            android:name="dev.nitrate.android.notifications.PartyActionReceiver"
            android:exported="false" />
    </application>
</manifest>
